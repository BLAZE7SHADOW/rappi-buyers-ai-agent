# ---- Agent runtime LLM ----
# Provider adapter to use: "gemini" (default) or "anthropic"
AI_PROVIDER=gemini
AI_MODEL=gemini-3.6-flash

# Supply the key for whichever provider is selected above.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Persistence ----
# SQLite by default so the app runs with no infrastructure.
# SQLAlchemy Core keeps this dialect-portable: a Postgres/Supabase URL works unchanged, e.g.
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./purchasing.db

# ---- Purchasing autonomy limits (integer minor units, i.e. cents) ----
# Spend at or below this executes without buyer approval.
AUTONOMY_SPEND_LIMIT_MINOR=200000
# Expedite fee at or below this executes without buyer approval.
AUTONOMY_FEE_LIMIT_MINOR=25000

# ---- Agent loop bounds ----
MAX_TOOL_CALLS=12
MAX_REPLANS=2
